# Backend Environment Variables Example

# Port the backend server will run on
PORT=5000

# Secret key used for signing JWT tokens (use a strong random string in production)
JWT_SECRET="super-secret-key-for-development"

# Database Connection String
# For local development with SQLite (default):
DATABASE_URL="file:./dev.db"

# For production with PostgreSQL (if using docker-compose):
# DATABASE_URL="postgresql://admin:adminpassword@localhost:5432/energy_db?schema=public"
